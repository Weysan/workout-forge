# ---------------------------------------------------------------------------
# FORGE — environment template
#
#   cp .env.example .env.local
#
# Every NEXT_PUBLIC_* value is embedded in the client bundle. That is expected
# for Firebase web config: these identifiers are public by design, and access is
# enforced by Firestore security rules (see firestore.rules), not by secrecy.
# ---------------------------------------------------------------------------

# --- Firebase web app config (Project settings → General → Your apps) -------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Public address -------------------------------------------------------
# Where this deployment lives. It is drawn onto shared images and sent with the
# share payload, so it is the link somebody types after seeing a result on
# Instagram. Optional: it falls back to the project's Firebase Hosting site, so
# a build with this unset still produces a working link. Set it when you put a
# custom domain in front. No trailing slash.
NEXT_PUBLIC_APP_URL=https://workout-forge-7f364.web.app

# --- Strava integration ---------------------------------------------------
# Both public. The client id is half of the authorize URL, so it is in the bundle
# by necessity; the *secret* is not here at all — it lives in the Cloudflare
# Worker under worker/, because Strava has no PKCE and requires it for both the
# code exchange and every token refresh. See worker/README.md.
#
# Leave both unset to build without the integration: the profile card says so
# rather than offering a button that leads nowhere.
NEXT_PUBLIC_STRAVA_CLIENT_ID=
# No trailing slash. http://localhost:8787 when running `wrangler dev` in worker/.
NEXT_PUBLIC_STRAVA_WORKER_URL=

# --- Local emulator -------------------------------------------------------
# When "true" the client talks to the Firebase emulator suite instead of the
# real project. `make dev` sets this for you; leave it unset/false otherwise.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Host the browser uses to reach the emulator. Stays "localhost" even when the
# app runs inside Docker, because the *browser* resolves these URLs.
NEXT_PUBLIC_EMULATOR_HOST=localhost
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
