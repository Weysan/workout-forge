# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
build/
next-env.d.ts

# production
dist/

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials
.env
.env*.local
.env.production

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log
firebase-export-*/

# emulator state is developer-local scratch data
.emulator-data/

# local code-search index: embeddings, metadata and a debug log that reaches
# hundreds of MB. Rebuilt on demand, and its debug.log alone exceeds GitHub's
# 100 MB per-file limit, so a commit that includes it cannot be pushed at all.
.code-search-mcp/

# typescript
*.tsbuildinfo

# service-account keys must never be committed
*service-account*.json
gcp-key*.json
